{
  "name": "trello-wdio-tests",
  "version": "1.0.0",
  "description": "WebdriverIO tests for Trello application",
  "main": "index.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:chrome": "wdio run wdio.conf.js",
    "test:firefox": "wdio run wdio.conf.js --spec.firefox",
    "test:headless": "wdio run wdio.conf.js",
    "test:login": "wdio run wdio.conf.js --spec ./test/login.spec.js",
    "test:signup": "wdio run wdio.conf.js --spec ./test/signup.spec.js",
    "test:profile": "wdio run wdio.conf.js --spec ./test/profile.spec.js",
    "test:logout": "wdio run wdio.conf.js --spec ./test/logout.spec.js",
    "test:parallel": "wdio run wdio.conf.js --maxInstances=2",
    "report:generate": "npx allure-commandline generate allure-results --clean && npx allure-commandline open allure-report",
    "report:clear": "rimraf allure-results allure-report",
    "lint": "eslint ./test ./src --ext .js",
    "lint:fix": "eslint ./test ./src --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "keywords": [
    "webdriverio",
    "mocha",
    "trello",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@wdio/allure-reporter": "^9.12.3",
    "@wdio/cli": "^9.12.4",
    "@wdio/local-runner": "^9.12.4",
    "@wdio/mocha-framework": "^9.12.3",
    "@wdio/spec-reporter": "^9.12.3",
    "allure-commandline": "^2.33.0",
    "chai": "^4.3.7",
    "chromedriver": "^135.0.1",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "geckodriver": "latest",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "@wdio/chromedriver-service": "^9.0.0",
    "@wdio/geckodriver-service": "^9.0.0"
  }
}
