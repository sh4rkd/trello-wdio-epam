{
  "name": "trello-api-tests",
  "version": "1.0.0",
  "description": "API tests for Trello using Axios and Mocha/Chai",
  "scripts": {
    "test": "mocha test/api/**/*.js --reporter spec",
    "test:board": "mocha test/api/board.test.js --reporter spec",
    "test:ci": "mocha test/api/**/*.js --reporter mochawesome --reporter-options reportDir=reports,reportFilename=trello-api-tests",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "format": "npm run prettier:fix && npm run lint:fix"
  },
  "keywords": [
    "trello",
    "api",
    "testing",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "axios": "^1.6.2",
    "chai": "^4.3.7",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "prettier": "^3.5.3"
  }
}
