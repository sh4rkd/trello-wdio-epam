{
    "name": "trello-api-tests",
    "version": "1.0.0",
    "description": "API tests for Trello using Axios and Mocha/Chai",
    "scripts": {
        "test": "mocha test/api/**/*.js --reporter spec",
        "test:board": "mocha test/api/board.test.js --reporter spec",
        "test:cucumber": "cucumber-js",
        "test:ci": "cucumber-js --format json:cucumber_report.json"
    },
    "keywords": [
        "trello",
        "api",
        "testing",
        "automation"
    ],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@babel/core": "^7.26.10",
        "@babel/preset-env": "^7.26.9",
        "@babel/register": "^7.25.9",
        "axios": "^1.6.2",
        "chai": "^4.5.0",
        "dotenv": "^16.3.1",
        "mocha": "^10.2.0",
        "mochawesome": "^7.1.3"
    },
    "dependencies": {
        "@cucumber/cucumber": "^11.2.0"
    }
}
