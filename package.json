{
  "name": "trello-wdio-tests",
  "version": "1.0.0",
  "description": "WebdriverIO tests for Trello application",
  "main": "index.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:chrome": "wdio run wdio.conf.js",
    "test:firefox": "wdio run wdio.conf.js --spec.firefox",
    "test:headless": "wdio run wdio.conf.js",
    "test:login": "wdio run wdio.conf.js --spec ./test/specs/login.spec.js",
    "test:signup": "wdio run wdio.conf.js --spec ./test/specs/signup.spec.js",
    "test:profile": "wdio run wdio.conf.js --spec ./test/specs/profile.spec.js",
    "test:logout": "wdio run wdio.conf.js --spec ./test/specs/logout.spec.js",
    "test:parallel": "wdio run wdio.conf.js --maxInstances=2"
  },
  "keywords": [
    "webdriverio",
    "mocha",
    "trello",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@wdio/cli": "^7.16.12",
    "@wdio/local-runner": "^7.16.12",
    "@wdio/mocha-framework": "^7.16.11",
    "@wdio/spec-reporter": "^7.16.11",
    "chai": "^4.3.7",
    "chromedriver": "latest",
    "dotenv": "^16.4.7",
    "geckodriver": "latest",
    "wdio-chromedriver-service": "^7.2.6",
    "wdio-geckodriver-service": "^3.0.2"
  }
}
