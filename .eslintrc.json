{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "mocha": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module",
    "requireConfigFile": false
  },
  "plugins": ["prettier"],
  "rules": {
    "prettier/prettier": "warn",
    "no-console": "off",
    "no-unused-vars": "warn",
    "prefer-const": "warn",
    "no-undef": "error",
    "camelcase": "warn",
    "eqeqeq": ["error", "always"],
    "max-len": ["warn", { "code": 120 }],
    "no-useless-catch": "warn",
    "no-useless-escape": "warn"
  },
  "globals": {
    "browser": true,
    "$": true,
    "$$": true,
    "expect": true
  },
  "ignorePatterns": ["node_modules/", "allure-results/", "driver-logs/", "spec-reports/"]
}
