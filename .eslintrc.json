{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "mocha": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "browser": "readonly",
    "$": "readonly",
    "$$": "readonly",
    "expect": "readonly",
    "describe": "readonly",
    "it": "readonly",
    "before": "readonly",
    "beforeEach": "readonly",
    "after": "readonly",
    "afterEach": "readonly"
  },
  "rules": {
    "prettier/prettier": "warn",
    "no-console": "off",
    "no-unused-vars": "warn",
    "prefer-const": "warn",
    "no-var": "warn",
    "eqeqeq": "warn",
    "no-useless-escape": "warn"
  },
  "ignorePatterns": [
    "node_modules/",
    "allure-results/",
    "allure-report/",
    "test-results/",
    "*.html",
    "*.json",
    ".git/",
    ".github/"
  ]
}
